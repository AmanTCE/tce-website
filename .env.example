# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Contact form delivery (server-side only). The form reports "not sent"
# until both of these are set. Uses the Resend HTTP API.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Optional analytics: Plausible domain, e.g. your-domain.example
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
